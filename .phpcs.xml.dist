<?xml version="1.0"?>
<!--
  Un solo estándar, en la RAÍZ y con rutas relativas a la raíz. Antes vivía en dev-tools/ con
  <file>.</file>: `vendor/bin/phpcs` a secas no lo encontraba (no hay autodescubrimiento) y
  respondía «You must supply at least one file» con salida 3 — el único de los diez repos (issue #7).
-->
<ruleset name="Convoca Assistant">
	<description>PHPCS rules for Convoca Assistant</description>

	<file>.</file>
	<exclude-pattern>./vendor/*</exclude-pattern>
	<exclude-pattern>./tests/*</exclude-pattern>
	<exclude-pattern>./node_modules/*</exclude-pattern>
	<exclude-pattern>./assets/*</exclude-pattern>
	<!-- Tooling de análisis estático: redefine constantes de runtime de WP
	     (ABSPATH, DAY_IN_SECONDS, ...) que por diseño no llevan el prefijo
	     del plugin. No es código distribuido, se excluye del lint PHPCS. -->
	<exclude-pattern>./phpstan-bootstrap.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress">
    <!--
      Exclusiones con motivo escrito. No es un silenciador: el estandar declara
      que se acepta y por que, y queda versionado en el repo.

      NoHtmlWrappedStrings: plantillas de CORREO HTML, donde el HTML es el propio
        contenido traducible; partirlo en trozos pierde contexto para el traductor.
      base64_encode/decode: tokens opacos de enlaces de pago y de checkin. No es
        ofuscacion de codigo, es el formato del dato.
      file_put_contents/get_contents/mkdir/touch: escritura en el propio directorio
        del plugin; WP_Filesystem exige credenciales FTP en muchos hostings.
      ValidHookName.UseUnderscores: hooks YA PUBLICADOS con guion; renombrarlos
        rompe las integraciones que los usan.
      PostsPerPage: exportadores de admin, que necesitan el conjunto entero.
      PreparedSQLPlaceholders: prepare() acepta un array como segundo argumento
        desde WP 4.9 y PHPCS no ve los placeholders de una variable interpolada.
        La regla sigue activa para el resto del codigo.
      CronInterval: el cron de un minuto es intencional (cola de correo y webhooks);
        hay issue abierto para valorar WP-Cron del sistema.
      AssignmentInCondition: patron while ( ( $x = f() ) !== false ), explicito.
      error_log: es la salida del propio convoca-core/includes/Logger.php.
    -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<!-- Autoload PSR-4: el fichero se llama como la clase (Indexer.php),
		     no class-indexer.php. Igual que NotHyphenatedLowercase. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound"/>
    <exclude name="WordPress.WP.I18n.NoHtmlWrappedStrings"/>
    <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode"/>
    <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_mkdir"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_touch"/>
    <exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
    <exclude name="WordPress.WP.PostsPerPage.posts_per_page_posts_per_page"/>
    <exclude name="WordPress.DB.PreparedSQLPlaceholders.UnfinishedPrepare"/>
    <exclude name="WordPress.DB.PreparedSQLPlaceholders.ReplacementsWrongNumber"/>
    <exclude name="WordPress.WP.CronInterval.CronSchedulesInterval"/>
    <exclude name="Generic.CodeAnalysis.AssignmentInCondition"/>
    <exclude name="WordPress.PHP.DevelopmentFunctions.error_log_error_log"/>

	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="convoca_assistant"/>
				<element value="Convoca_Assistant"/>
				<element value="Convoca\Assistant"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="convoca-assistant"/>
			</property>
		</properties>
	</rule>

	<rule ref="Generic.Commenting.Todo">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!-- El nombre de tabla en {$table} no admite prepare() (SQL no permite
	     bindear identificadores); procede de Installer::log_table()/
	     Statistics::table(), valores de confianza del propio plugin. -->
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
	</rule>

	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="160"/>
			<property name="absoluteLineLimit" value="200"/>
		</properties>
	</rule>
  <!--
    Exclusiones con motivo. No son un silenciador: declaran que se acepta y por que.
    1. DirectDatabaseQuery (723 avisos): los plugins consultan TABLAS PROPIAS
       (convoca_inscripciones, convoca_pagos...) con agregados y JOIN que la API de
       WP no cubre. NoCaching tampoco aplica: son datos por-usuario y por-peticion.
    2. SlowDBQuery (159): el modelo de datos es CPT + postmeta; la consulta por
       meta_key/meta_value es la unica via, no una eleccion.
    3. UnusedFunctionParameter (108): callbacks de WordPress cuya firma impone el
       propio hook ($items,$args / $post_id,$post / $column_name,$post_id).
  -->
  <rule ref="WordPress.DB.DirectDatabaseQuery">
    <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>
  </rule>
  <rule ref="WordPress.DB.SlowDBQuery">
    <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_query"/>
    <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_key"/>
    <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_value"/>
    <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_tax_query"/>
  </rule>
  <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
    <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.Found"/>
    <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed"/>
  </rule>
  <!--
    La cabecera del plugin la lee WordPress de UNA sola linea (`Description:`):
    partirla corta la descripcion. Se excluye la longitud SOLO para ese fichero.
  -->
  <rule ref="Generic.Files.LineLength">
    <exclude-pattern>*/convoca-assistant.php</exclude-pattern>
  </rule>
</ruleset>
