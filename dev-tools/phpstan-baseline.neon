parameters:
	ignoreErrors:
		-
			message: '#^Constant CONVOCA_ASSISTANT_DIR not found\.$#'
			identifier: constant.notFound
			count: 7
			path: ../includes/Admin.php

		-
			message: '#^Parameter \#1 \$array \(list\<array\{id\: int, type\: mixed, weight\: float\}\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: ../includes/Graph_Builder.php

		-
			message: '#^Constant CONVOCA_ASSISTANT_DIR not found\.$#'
			identifier: constant.notFound
			count: 1
			path: ../includes/I18n.php

		-
			message: '#^Call to static method error\(\) on an unknown class Convoca\\Core\\Logger\.$#'
			identifier: class.notFound
			count: 1
			path: ../includes/Indexer.php

		-
			message: '#^Call to static method info\(\) on an unknown class Convoca\\Core\\Logger\.$#'
			identifier: class.notFound
			count: 2
			path: ../includes/Indexer.php

		-
			message: '#^Static method Convoca\\Assistant\\Indexer\:\:build_entry\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: ../includes/Indexer.php

		-
			message: '#^Path in require_once\(\) "/tmp/wp/wp\-admin/includes/upgrade\.php" is not a file or it does not exist\.$#'
