			count: 1
			path: ../includes/Installer.php

		-
			message: '#^Method Convoca\\Assistant\\REST_Controller\:\:check_rate_limit\(\) has invalid return type Convoca\\Assistant\\WP_Error\.$#'
			identifier: class.notFound
			count: 1
			path: ../includes/REST_Controller.php

		-
			message: '#^Method Convoca\\Assistant\\REST_Controller\:\:check_rate_limit\(\) should return bool\|Convoca\\Assistant\\WP_Error but returns WP_Error\.$#'
			identifier: return.type
			count: 1
			path: ../includes/REST_Controller.php

		-
			message: '#^Constant CONVOCA_ASSISTANT_DIR not found\.$#'
			identifier: constant.notFound
			count: 1
			path: ../includes/Widget.php

		-
			message: '#^Variable \$text on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: ../includes/providers/Posts_Provider.php

		-
