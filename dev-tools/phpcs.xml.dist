<?xml version="1.0"?>
<ruleset name="Convoca Assistant">
	<description>PHPCS rules for Convoca Assistant</description>

	<file>../</file>
	<exclude-pattern>../vendor/*</exclude-pattern>
	<exclude-pattern>../tests/*</exclude-pattern>
	<exclude-pattern>../node_modules/*</exclude-pattern>
	<exclude-pattern>../assets/*</exclude-pattern>
	<!-- Tooling de análisis estático: redefine constantes de runtime de WP
	     (ABSPATH, DAY_IN_SECONDS, ...) que por diseño no llevan el prefijo
	     del plugin. No es código distribuido, se excluye del lint PHPCS. -->
	<exclude-pattern>../phpstan-bootstrap.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<!-- Autoload PSR-4: el fichero se llama como la clase (Indexer.php),
		     no class-indexer.php. Igual que NotHyphenatedLowercase. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="convoca_assistant"/>
				<element value="Convoca_Assistant"/>
				<element value="Convoca\Assistant"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="convoca-assistant"/>
			</property>
		</properties>
	</rule>

	<rule ref="Generic.Commenting.Todo">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!-- El nombre de tabla en {$table} no admite prepare() (SQL no permite
	     bindear identificadores); procede de Installer::log_table()/
	     Statistics::table(), valores de confianza del propio plugin. -->
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
	</rule>

	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="160"/>
			<property name="absoluteLineLimit" value="200"/>
		</properties>
	</rule>
</ruleset>
