includes:
	- phpstan-baseline.neon

parameters:
	level: 8
	reportUnmatchedIgnoredErrors: false
	treatPhpDocTypesAsCertain: false
	paths:
		- ../includes/
		- ../convoca-assistant.php
		- ../uninstall.php
	excludePaths:
		- ../vendor/*
		- ../tests/*
		- ../node_modules/*
	bootstrapFiles:
		- ../vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- ../phpstan-bootstrap.php
	ignoreErrors:
		# ── Falsos positivos del harness de análisis (NO deuda de código) ──
		# En análisis aislado ABSPATH=/tmp/wp/, así que include()/require_once()
		# de plantillas y de wp-admin no existen en disco. En runtime WP
		# resuelve las rutas reales del plugin y del core.
		-
			message: '#Path in (?:include|require_once)\(\) "/tmp/wp/#'
			identifier: include.fileNotFound
		-
			message: '#Path in (?:include|require_once)\(\) "/tmp/wp/#'
			identifier: requireOnce.fileNotFound
		# WP_Query::$posts lo declara el stub oficial como WP_Post[]|int[]|null. En este
		# código solo se recorre después de la consulta, donde siempre es WP_Post[].
		-
			message: '#Cannot access property \$\w+ on int\|WP_Post#'
			identifier: property.nonObject
		-
			message: '#array<int\|WP_Post>\|null#'
			identifier: foreach.nonIterable
	parallel:
		maximumNumberOfProcesses: 4
