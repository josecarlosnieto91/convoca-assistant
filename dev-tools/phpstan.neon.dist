includes:
	- phpstan-baseline.neon

parameters:
	level: 5
	treatPhpDocTypesAsCertain: false
	paths:
		- ../includes/
		- ../convoca-assistant.php
		- ../uninstall.php
	excludePaths:
		- ../vendor/*
		- ../tests/*
		- ../node_modules/*
	bootstrapFiles:
		- ../vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- ../phpstan-bootstrap.php
	parallel:
		maximumNumberOfProcesses: 4
