{
    "name": "convoca/assistant",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "description": "Asistente conversacional local sin IA para WordPress. Búsqueda difusa con Fuse.js.",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.4",
        "php-stubs/wordpress-stubs": "^7.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Convoca\\Assistant\\": "includes/",
            "Convoca\\Assistant\\Providers\\": "includes/providers/"
        }
    },
    "scripts": {
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "phpcbf": "phpcbf --standard=.phpcs.xml.dist",
        "phpstan": "phpstan analyse --configuration=dev-tools/phpstan.neon.dist --memory-limit=4G",
        "phpunit": "phpunit",
        "test": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ],
        "test:quality": [
            "@php vendor/bin/phpunit --no-coverage --filter SearchQualityTest",
            "cd tests && npx jest search-quality-client",
            "@php tests/quality-table.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
